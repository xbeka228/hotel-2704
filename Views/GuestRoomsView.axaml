<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HotelManagement.ViewModels"
             x:Class="HotelManagement.Views.GuestRoomsView"
             x:DataType="vm:GuestRoomsViewModel">

    <DockPanel Margin="25,20">
        <StackPanel DockPanel.Dock="Top" Spacing="15" Margin="0,0,0,15">
            <TextBlock Text="{Binding L.SelectRoom}" FontSize="26" FontWeight="Bold" Foreground="#1B3A5C"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- Standart -->
                <Button Command="{Binding SelectClassCommand}" CommandParameter="Standart"
                        Background="#2980B9" Foreground="White"
                        Padding="16,10" CornerRadius="12" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 2D bed icon -->
                        <Canvas Width="28" Height="20">
                            <Rectangle Canvas.Left="2" Canvas.Top="14" Width="24" Height="4"
                                       Fill="White" RadiusX="1" RadiusY="1"/>
                            <Rectangle Canvas.Left="0" Canvas.Top="10" Width="12" Height="6"
                                       Fill="White" RadiusX="2" RadiusY="2"/>
                            <Rectangle Canvas.Left="3" Canvas.Top="7" Width="6" Height="4"
                                       Fill="#85C1E9" RadiusX="1" RadiusY="1"/>
                            <Rectangle Canvas.Left="2" Canvas.Top="17" Width="2" Height="3" Fill="White"/>
                            <Rectangle Canvas.Left="24" Canvas.Top="17" Width="2" Height="3" Fill="White"/>
                        </Canvas>
                        <TextBlock Text="Standart" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Comfort -->
                <Button Command="{Binding SelectClassCommand}" CommandParameter="Comfort"
                        Background="#E67E22" Foreground="White"
                        Padding="16,10" CornerRadius="12" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 2D sofa + bed icon -->
                        <Canvas Width="30" Height="20">
                            <Rectangle Canvas.Left="2" Canvas.Top="12" Width="26" Height="5"
                                       Fill="White" RadiusX="2" RadiusY="2"/>
                            <Rectangle Canvas.Left="0" Canvas.Top="8" Width="14" Height="7"
                                       Fill="White" RadiusX="2" RadiusY="2"/>
                            <Rectangle Canvas.Left="3" Canvas.Top="5" Width="5" Height="4"
                                       Fill="#F5CBA7" RadiusX="1" RadiusY="1"/>
                            <Rectangle Canvas.Left="9" Canvas.Top="5" Width="5" Height="4"
                                       Fill="#F5CBA7" RadiusX="1" RadiusY="1"/>
                            <Ellipse Canvas.Left="20" Canvas.Top="4" Width="8" Height="8"
                                     Fill="#F5CBA7"/>
                            <Rectangle Canvas.Left="1" Canvas.Top="16" Width="2" Height="4" Fill="White"/>
                            <Rectangle Canvas.Left="27" Canvas.Top="16" Width="2" Height="4" Fill="White"/>
                        </Canvas>
                        <TextBlock Text="Comfort" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Luxe -->
                <Button Command="{Binding SelectClassCommand}" CommandParameter="Luxe"
                        Background="#C9A92C" Foreground="White"
                        Padding="16,10" CornerRadius="12" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 2D crown / luxury icon -->
                        <Canvas Width="28" Height="22">
                            <Polygon Points="14,0 18,7 26,4 22,14 6,14 2,4 10,7"
                                     Fill="White"/>
                            <Rectangle Canvas.Left="5" Canvas.Top="14" Width="18" Height="4"
                                       Fill="White" RadiusX="1" RadiusY="1"/>
                            <Ellipse Canvas.Left="6" Canvas.Top="5" Width="3" Height="3" Fill="#F9E154"/>
                            <Ellipse Canvas.Left="12" Canvas.Top="1" Width="3" Height="3" Fill="#F9E154"/>
                            <Ellipse Canvas.Left="19" Canvas.Top="5" Width="3" Height="3" Fill="#F9E154"/>
                        </Canvas>
                        <TextBlock Text="Luxe" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding L.CurrentClass}" FontSize="13" Foreground="#888"/>
                <TextBlock Text=": " FontSize="13" Foreground="#888"/>
                <TextBlock Text="{Binding SelectedClass}" FontSize="13" Foreground="#1B3A5C" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding $parent[UserControl].DataContext.OpenRoomCommand}"
                                CommandParameter="{Binding}"
                                Margin="0,0,15,15" Padding="0" CornerRadius="10"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Left">
                            <Border Background="White" CornerRadius="10"
                                    Width="250" BoxShadow="0 2 10 0 #20000000">
                                <StackPanel>
                                    <Border Height="150" CornerRadius="10,10,0,0" ClipToBounds="True">
                                        <Panel>
                                            <Border Background="#D5E8F7">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="🏨" FontSize="40" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Class}" FontSize="12" Foreground="#1B3A5C"
                                                               HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding Photo1, StringFormat='avares://HotelManagement/Assets/Photos/{0}'}"/>
                                        </Panel>
                                    </Border>
                                    <Border Padding="15,12">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Number, StringFormat='№ {0}'}"
                                                       FontSize="17" FontWeight="Bold" Foreground="#1B3A5C"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12" Foreground="#777"
                                                       TextWrapping="Wrap" MaxLines="2"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} тг/сут'}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="#2980B9" Margin="0,3,0,0"/>
                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <Binding Path="IsAvailable"
                                                             Converter="{x:Static vm:StatusConverter.Instance}"/>
                                                </TextBlock.Text>
                                                <TextBlock.Foreground>
                                                    <Binding Path="IsAvailable"
                                                             Converter="{x:Static vm:StatusColorConverter.Instance}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
