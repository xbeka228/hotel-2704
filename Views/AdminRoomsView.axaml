<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HotelManagement.ViewModels"
             x:Class="HotelManagement.Views.AdminRoomsView"
             x:DataType="vm:AdminRoomsViewModel">

    <DockPanel Margin="25,20">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock Text="{Binding L.ManageRooms}"
                           FontSize="24" FontWeight="Bold" Foreground="#1B3A5C"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{Binding L.AddRoom}" Command="{Binding AddRoomCommand}"
                            Background="#27AE60" Foreground="White"
                            Padding="15,8" CornerRadius="6" FontSize="13" FontWeight="SemiBold"/>
                    <Button Content="{Binding L.Refresh}" Command="{Binding RefreshCommand}"
                            Background="#3498DB" Foreground="White"
                            Padding="15,8" CornerRadius="6" FontSize="13"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Message}" FontSize="13" IsVisible="{Binding Message.Length}">
                <TextBlock.Foreground>
                    <Binding Path="IsMessageSuccess"
                             Converter="{x:Static vm:MessageColorConverter.Instance}"/>
                </TextBlock.Foreground>
            </TextBlock>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="18,14"
                                Margin="0,0,0,8" BoxShadow="0 1 5 0 #15000000">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1B3A5C">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="№ {0} — {1}">
                                                <Binding Path="Number"/>
                                                <Binding Path="Class"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="13" Foreground="#777"
                                               TextWrapping="Wrap" MaxLines="1"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} тг/сут'}"
                                                   FontSize="14" Foreground="#2980B9" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <Binding Path="IsAvailable"
                                                         Converter="{x:Static vm:StatusConverter.Instance}"/>
                                            </TextBlock.Text>
                                            <TextBlock.Foreground>
                                                <Binding Path="IsAvailable"
                                                         Converter="{x:Static vm:StatusColorConverter.Instance}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            Spacing="6" VerticalAlignment="Center">
                                    <Button Content="{Binding $parent[UserControl].DataContext.L.EditBtn}"
                                            Command="{Binding $parent[UserControl].DataContext.EditRoomCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#3498DB" Foreground="White"
                                            Padding="12,6" CornerRadius="5" FontSize="12"/>
                                    <Button Content="{Binding $parent[UserControl].DataContext.L.StatusBtn}"
                                            Command="{Binding $parent[UserControl].DataContext.ToggleStatusCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#F39C12" Foreground="White"
                                            Padding="12,6" CornerRadius="5" FontSize="12"/>
                                    <Button Content="{Binding $parent[UserControl].DataContext.L.Delete}"
                                            Command="{Binding $parent[UserControl].DataContext.DeleteRoomCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#E74C3C" Foreground="White"
                                            Padding="12,6" CornerRadius="5" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
